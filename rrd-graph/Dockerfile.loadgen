# Build stage
FROM python:3.13-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY apps/loadgen/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Copy the local rrd_shared package
COPY libs/rrd_shared ./libs/rrd_shared

# Runtime stage
FROM python:3.13-slim

WORKDIR /app

# Copy Python packages from builder stage
COPY --from=builder /root/.local /root/.local

# Copy the rrd_shared library directly
COPY libs/rrd_shared ./libs/rrd_shared

# Copy application code
COPY apps/loadgen/ .

# Make sure scripts in .local are usable and Python can find the library
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/app:/app/libs:$PYTHONPATH

# Expose port
EXPOSE 8000

# Set the command to run the loadgen job
CMD ["python", "main.py"]
